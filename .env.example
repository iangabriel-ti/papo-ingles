# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Opcional: modelo usado nas lições e conversas (padrão: claude-opus-5-5).
# "claude-haiku-5-5" custa bem menos por conversa.
# CLAUDE_MODEL=claude-opus-5-5

# Opcional: esforço de raciocínio da IA (low, medium ou high). Padrão: low.
# CLAUDE_EFFORT=low
