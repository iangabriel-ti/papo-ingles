# Copie este arquivo para .env.local (no computador) ou cadastre as variáveis na Vercel.

# --- IA (Anthropic) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Opcional: modelo das lições e conversas (padrão: claude-opus-5-5).
# "claude-haiku-5-5" custa bem menos por conversa.
# CLAUDE_MODEL=claude-opus-5-5
# Opcional: esforço de raciocínio da IA (low, medium ou high). Padrão: low.
# CLAUDE_EFFORT=low

# --- Endereço do site (sem barra no final) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Login e banco de dados (Supabase → Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Chave "publishable" (ou a antiga "anon")
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave "secret" (ou a antiga "service_role"). Nunca coloque no navegador.
SUPABASE_SECRET_KEY=

# --- Pagamentos (Stripe → Developers → API keys) ---
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → seu endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# IDs dos preços recorrentes do produto "Papo Super" (começam com price_)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# "true" para oferecer Pix no plano anual (ative o Pix no painel do Stripe antes)
STRIPE_PIX_ENABLED=false
